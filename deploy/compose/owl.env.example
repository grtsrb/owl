# Owl configuration for deploy/compose. Copy to .env (Compose reads it automatically), `chmod 600 .env`,
# fill in, then
#   docker compose up -d
# Every variable: docs/configuration.md. Secrets live only here (and in your password manager).

# --- required ---
OWL_IMAGE=registry.gitlab.example.com/devops/owl:0.9.0
# DNS A/AAAA record -> this host; Caddy gets the certificate
OWL_DOMAIN=owl.example.com
OWL_PUBLIC_URL=https://owl.example.com
# on its own EBS volume; `sudo chown 65532:65532 /srv/owl`
OWL_DATA_DIR=/srv/owl

# --- upstream data (GitHub token with no scopes: public read only) ---
GITHUB_TOKEN=

# --- Google sign-in (optional; invited users can always use a password until you turn that off) ---
OWL_GOOGLE_CLIENT_ID=
OWL_GOOGLE_CLIENT_SECRET=
# e.g. example.com: only that Google Workspace's accounts
OWL_GOOGLE_DOMAIN=

# --- email for invites and password resets (optional; without it, admins copy the links) ---
OWL_SMTP_HOST=
OWL_SMTP_PORT=587
# starttls (587) or tls (465)
OWL_SMTP_TLS=starttls
OWL_SMTP_USERNAME=
OWL_SMTP_PASSWORD=
OWL_SMTP_FROM=Owl <owl@example.com>

# --- Mattermost notifications (optional): an incoming webhook URL; switch them on in Settings → Notifications ---
OWL_MATTERMOST_WEBHOOK_URL=

# --- backups to S3 (strongly recommended: otherwise backups sit on the same disk) ---
OWL_BACKUP_S3_BUCKET=
OWL_BACKUP_S3_REGION=eu-central-1
OWL_BACKUP_S3_PREFIX=owl
OWL_BACKUP_S3_ACCESS_KEY=
OWL_BACKUP_S3_SECRET_KEY=

# --- image vulnerability scans (Trivy, in the image; on by default) ---
# registry logins for private images: add them in Settings → Registries (needs OWL_SECRET_KEY, which
# encrypts them: openssl rand -base64 32 — keep a copy outside this server, a restore needs the same key) …
OWL_SECRET_KEY=
# … or mount registries.yaml (compose.yaml) and set
#OWL_REGISTRY_AUTH_FILE=/run/secrets/owl-registries.yaml
# OWL_SCAN=off switches scanning off (e.g. on a small instance)
OWL_SCAN=

# --- optional ---
# e.g. registry.gitlab.example.com (in-house images)
OWL_INTERNAL_REGISTRIES=
OWL_LOG_LEVEL=info
# Claude upgrade summaries (off by default; see docs/configuration.md before setting a key)
ANTHROPIC_API_KEY=
